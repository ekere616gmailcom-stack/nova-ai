{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user account profile, subscription plan, daily quota, and localization preferences.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500
        },
        "plan": {
          "type": "string",
          "enum": ["free", "premium"]
        },
        "language": {
          "type": "string",
          "enum": ["en", "es", "fr", "pt", "ar", "hi", "zh"]
        },
        "voiceName": {
          "type": "string",
          "enum": ["Zephyr", "Kore", "Puck", "Charon", "Fenrir"]
        },
        "dailyChatCount": {
          "type": "integer"
        },
        "dailyImageCount": {
          "type": "integer"
        },
        "lastUsageDate": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "displayName",
        "email",
        "plan",
        "language",
        "voiceName",
        "dailyChatCount",
        "dailyImageCount",
        "lastUsageDate",
        "createdAt",
        "updatedAt"
      ]
    },
    "ChatSession": {
      "title": "ChatSession",
      "description": "A conversation session belonging to a specific user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "lastMessagePreview": {
          "type": "string",
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "title",
        "lastMessagePreview",
        "createdAt",
        "updatedAt"
      ]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "An individual message inside a user's chat session.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "chatId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "role": {
          "type": "string",
          "enum": ["user", "assistant"]
        },
        "kind": {
          "type": "string",
          "enum": ["text", "image", "voice"]
        },
        "content": {
          "type": "string",
          "maxLength": 50000
        },
        "imageDataUrl": {
          "type": "string",
          "maxLength": 400000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "chatId",
        "role",
        "kind",
        "content",
        "createdAt"
      ]
    },
    "Contact": {
      "title": "Contact",
      "description": "A saved phone contact for Nova Call feature.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "name", "phone", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user account document containing profile info, plan, daily quota, and settings."
    },
    "/users/{userId}/chats/{chatId}": {
      "schema": { "$ref": "#/entities/ChatSession" },
      "description": "User-owned conversation threads for sidebar chat history."
    },
    "/users/{userId}/chats/{chatId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Messages within a user-owned conversation thread."
    },
    "/users/{userId}/contacts/{contactId}": {
      "schema": { "$ref": "#/entities/Contact" },
      "description": "User-saved phone contacts for Nova Call cards."
    }
  }
}
